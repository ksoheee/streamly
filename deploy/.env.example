# cp .env.example .env 후 값을 바꾼다. .env 는 저장소에 올리지 않는다.

# 서버 공인 IP와 sslip.io 도메인 (IP 1.2.3.4 → 1-2-3-4.sslip.io)
PUBLIC_IP=1.2.3.4
DOMAIN=1-2-3-4.sslip.io

# DB 비밀번호
POSTGRES_PASSWORD=change-me

# 심사용 테스트 계정(demo-owner, demo-viewer) 비밀번호. README에 공개한다.
DEMO_PASSWORD=change-me
# 토스페이먼츠 테스트 키 (개발자센터 > API 키, test_ 로 시작). 비우면 후원 결제를 막는다
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
